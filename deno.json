{
  "name": "@marianmeres/cityscape",
  "version": "1.5.0",
  "exports": {
    ".": "./src/mod.ts",
    "./engine": "./src/engine/mod.ts",
    "./cityscape": "./src/cityscape/mod.ts",
    "./naturescape": "./src/naturescape/mod.ts",
    "./shapes": "./src/shapes/mod.ts",
    "./render/canvas": "./src/render/canvas/mod.ts",
    "./render/ascii": "./src/render/ascii/mod.ts",
    "./render/pixelart": "./src/render/pixelart/mod.ts",
    "./ui": "./src/ui/mod.ts"
  },
  "compilerOptions": {
    "lib": [
      "deno.ns",
      "dom",
      "dom.iterable",
      "esnext"
    ]
  },
  "publish": {
    "exclude": [
      "docs",
      "tmp",
      "example",
      ".env.example",
      "scripts",
      "tests"
    ]
  },
  "lint": {
    "exclude": [
      "example/dist"
    ]
  },
  "tasks": {
    "test": "deno test -A",
    "test:watch": "deno test -A --watch",
    "check": "deno check src/ tests/",
    "example:build": "deno run -A jsr:@marianmeres/deno-build --root example --entry main.ts --outdir example/dist",
    "example:watch": "deno run -A jsr:@marianmeres/deno-build --root example --entry main.ts --outdir example/dist --watch --watch-dir src",
    "example:theme": "deno run -A example/theme/_generate.ts",
    "example:icons": "example/icons/_generate.sh",
    "serve": "deno run -A jsr:@std/http/file-server -p 8000 --host 0.0.0.0 .",
    "build:all": "deno task example:theme && deno task example:build",
    "npm:build": "deno run -A scripts/build-npm.ts",
    "npm:publish": "deno run -A scripts/build-npm.ts && cd ./.npm-dist && npm publish --access=public",
    "release": "deno run -A jsr:@marianmeres/deno-release",
    "publish": "deno publish && deno task npm:publish",
    "rp": "deno task release -y && deno task publish",
    "rpm": "deno task release minor -y && deno task publish"
  },
  "imports": {
    "@marianmeres/design-tokens": "jsr:@marianmeres/design-tokens@^1",
    "@marianmeres/npmbuild": "jsr:@marianmeres/npmbuild@^1",
    "@marianmeres/vanilla": "jsr:@marianmeres/vanilla@^1.8.0",
    "@std/assert": "jsr:@std/assert@^1"
  },
  "fmt": {
    "exclude": [
      "example/dist"
    ],
    "useTabs": true,
    "lineWidth": 90,
    "indentWidth": 4,
    "proseWrap": "preserve"
  }
}
