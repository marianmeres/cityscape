{
	"name": "@marianmeres/cityscape — three worlds",
	"short_name": "Cityscape",
	"description": "A night city skyline, a sunlit nature valley and a polyomino puzzle — three worlds on one headless engine with a swappable Canvas · ASCII · Pixel renderer seam.",
	"id": "./",
	"start_url": "./",
	"scope": "./",
	"display": "fullscreen",
	"display_override": ["fullscreen", "standalone"],
	"orientation": "portrait",
	"background_color": "#06080f",
	"theme_color": "#0a0f1e",
	"icons": [
		{
			"src": "./icons/icon-192.png",
			"sizes": "192x192",
			"type": "image/png",
			"purpose": "any"
		},
		{
			"src": "./icons/icon-512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "any"
		},
		{
			"src": "./icons/icon-maskable-512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "maskable"
		},
		{
			"src": "./icons/icon.svg",
			"sizes": "any",
			"type": "image/svg+xml",
			"purpose": "any"
		}
	]
}
